<?xml version="1.0" encoding="UTF-8"?>
<!-- Adapter test fixture. Same invoice-approval story as
     contracts/examples/artifact.bpmn / tests/fixtures/spiff/executable_invoice.bpmn,
     extended with the features the shared fixture has none of: a timer, a
     multi-instance loop, task-level variable read/write markers, and an
     agent-vs-service-task distinction. Structurally valid (Gateway_amount has
     both a default flow and a real conditionExpression, per the executable
     fixture's fix; this one is not testing the planted STR-* defect).

     `uipath:*` here is a PROVISIONAL convention, not a verified UiPath Maestro
     export; there is no real sample in this repo to copy from yet (see
     docs/handoff/P1.md, 2026-08-03 entry). `activityType`/`assetRef` and the
     <uipath:variables> extension are wfeval-adapters' own placeholder for
     however UiPath actually marks these, isolated to bpmn.py's tag-mapping
     so it's a one-file change when a real export arrives. Everything else
     (conditionExpression, multiInstanceLoopCharacteristics, timerEventDefinition,
     the gateway `default` attribute) is standard BPMN 2.0, not UiPath-specific,
     and is exercised here with real spec-compliant markup. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:uipath="http://uipath.com/schema/maestro"
             id="Defs_invoice_rich" targetNamespace="http://uipath.com/maestro">
  <process id="Process_invoice_approval_rich" isExecutable="true">
    <startEvent id="StartEvent_invoice" name="Invoice received"/>

    <serviceTask id="Task_extract" name="Extract invoice fields" uipath:activityType="Agent">
      <extensionElements>
        <uipath:variables>
          <uipath:write name="vendor"/>
          <uipath:write name="amount"/>
          <uipath:write name="line_items"/>
        </uipath:variables>
      </extensionElements>
    </serviceTask>

    <exclusiveGateway id="Gateway_amount" name="Amount over 10000?" default="Flow_4"/>

    <intermediateCatchEvent id="Timer_approval_sla" name="Approval SLA">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P2D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <userTask id="Task_approval" name="Manager approval">
      <extensionElements>
        <uipath:variables>
          <uipath:read name="amount"/>
          <uipath:write name="approved"/>
        </uipath:variables>
      </extensionElements>
    </userTask>

    <serviceTask id="Task_autopay" name="Auto-pay invoice" uipath:activityType="Process" uipath:assetRef="ChargePayment">
      <extensionElements>
        <uipath:variables>
          <uipath:read name="amount"/>
          <uipath:write name="transaction_id"/>
        </uipath:variables>
      </extensionElements>
    </serviceTask>

    <serviceTask id="Task_notify_line_item" name="Notify vendor for each line item"
                 uipath:activityType="Process" uipath:assetRef="NotifyVendor">
      <extensionElements>
        <uipath:variables>
          <uipath:read name="line_items"/>
        </uipath:variables>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false">
        <loopCardinality xsi:type="tFormalExpression">line_items.count</loopCardinality>
      </multiInstanceLoopCharacteristics>
    </serviceTask>

    <endEvent id="EndEvent_done" name="Invoice settled"/>

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_invoice" targetRef="Task_extract"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_extract" targetRef="Gateway_amount"/>
    <sequenceFlow id="Flow_3" sourceRef="Gateway_amount" targetRef="Timer_approval_sla" name="over">
      <conditionExpression xsi:type="tFormalExpression">amount &gt; 10000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_4" sourceRef="Gateway_amount" targetRef="Task_autopay" name="under"/>
    <sequenceFlow id="Flow_5" sourceRef="Timer_approval_sla" targetRef="Task_approval"/>
    <sequenceFlow id="Flow_6" sourceRef="Task_approval" targetRef="Task_notify_line_item"/>
    <sequenceFlow id="Flow_7" sourceRef="Task_autopay" targetRef="Task_notify_line_item"/>
    <sequenceFlow id="Flow_8" sourceRef="Task_notify_line_item" targetRef="EndEvent_done"/>
  </process>
</definitions>
