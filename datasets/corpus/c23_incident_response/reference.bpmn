<?xml version="1.0" encoding="UTF-8"?>
<!-- c23_incident_response - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_incident_response" targetNamespace="http://uipath.com/maestro">
  <process id="Process_incident_response" isExecutable="true">
    <startEvent id="StartEvent_alert" name="Monitoring alert raised">
      <messageEventDefinition />
    </startEvent>
    <serviceTask id="Task_enrich_alert" name="Enrich with service and recent deploys" />
    <exclusiveGateway id="Gateway_sev" name="Severity?" default="Flow_11" />
    <parallelGateway id="Gateway_sev1_fanout" name="Sev1 fan-out" />
    <sendTask id="Task_page" name="Page on-call" />
    <serviceTask id="Task_status_page" name="Update status page" />
    <serviceTask id="Task_bridge" name="Open bridge call" />
    <parallelGateway id="Gateway_sev1_fanout_join" />
    <sendTask id="Task_page_only" name="Page on-call" />
    <serviceTask id="Task_next_day_ticket" name="Create next-working-day ticket" />
    <endEvent id="EndEvent_ticketed" name="Ticket raised" />
    <exclusiveGateway id="Gateway_sev_join" />
    <userTask id="Task_close_incident" name="Close incident" />
    <userTask id="Task_postmortem" name="Write postmortem" />
    <endEvent id="EndEvent_incident_closed" name="Incident closed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_alert" targetRef="Task_enrich_alert" />
    <sequenceFlow id="Flow_02" sourceRef="Task_enrich_alert" targetRef="Gateway_sev" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_sev" targetRef="Gateway_sev1_fanout" name="Sev1">
      <conditionExpression xsi:type="tFormalExpression">severity == 'Sev1'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Gateway_sev1_fanout" targetRef="Task_page" name="page" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_sev1_fanout" targetRef="Task_status_page" name="status page" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_sev1_fanout" targetRef="Task_bridge" name="bridge" />
    <sequenceFlow id="Flow_07" sourceRef="Task_page" targetRef="Gateway_sev1_fanout_join" />
    <sequenceFlow id="Flow_08" sourceRef="Task_status_page" targetRef="Gateway_sev1_fanout_join" />
    <sequenceFlow id="Flow_09" sourceRef="Task_bridge" targetRef="Gateway_sev1_fanout_join" />
    <sequenceFlow id="Flow_10" sourceRef="Gateway_sev" targetRef="Task_page_only" name="Sev2">
      <conditionExpression xsi:type="tFormalExpression">severity == 'Sev2'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_11" sourceRef="Gateway_sev" targetRef="Task_next_day_ticket" name="Sev3" />
    <sequenceFlow id="Flow_12" sourceRef="Task_next_day_ticket" targetRef="EndEvent_ticketed" />
    <sequenceFlow id="Flow_13" sourceRef="Gateway_sev1_fanout_join" targetRef="Gateway_sev_join" />
    <sequenceFlow id="Flow_14" sourceRef="Task_page_only" targetRef="Gateway_sev_join" />
    <sequenceFlow id="Flow_15" sourceRef="Gateway_sev_join" targetRef="Task_close_incident" />
    <sequenceFlow id="Flow_16" sourceRef="Task_close_incident" targetRef="Task_postmortem" />
    <sequenceFlow id="Flow_17" sourceRef="Task_postmortem" targetRef="EndEvent_incident_closed" />
  </process>
</definitions>
