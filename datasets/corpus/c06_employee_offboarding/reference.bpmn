<?xml version="1.0" encoding="UTF-8"?>
<!-- c06_employee_offboarding - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_employee_offboarding" targetNamespace="http://uipath.com/maestro">
  <process id="Process_employee_offboarding" isExecutable="true">
    <startEvent id="StartEvent_last_day" name="Last working day reached">
      <timerEventDefinition>
        <timeCycle>P0D</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <parallelGateway id="Gateway_revoke" name="Revoke and collect in parallel" />
    <serviceTask id="Task_revoke_access" name="Revoke system access" />
    <manualTask id="Task_collect_kit" name="Collect equipment" />
    <parallelGateway id="Gateway_revoke_join" />
    <exclusiveGateway id="Gateway_leaver_type" name="Voluntary leaver?" default="Flow_08" />
    <userTask id="Task_exit_interview" name="Schedule exit interview" />
    <sendTask id="Task_notify_legal" name="Notify legal" />
    <exclusiveGateway id="Gateway_leaver_type_join" />
    <serviceTask id="Task_archive_mailbox" name="Archive mailbox" />
    <endEvent id="EndEvent_offboarded" name="Employee offboarded" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_last_day" targetRef="Gateway_revoke" />
    <sequenceFlow id="Flow_02" sourceRef="Gateway_revoke" targetRef="Task_revoke_access" name="access" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_revoke" targetRef="Task_collect_kit" name="equipment" />
    <sequenceFlow id="Flow_04" sourceRef="Task_revoke_access" targetRef="Gateway_revoke_join" />
    <sequenceFlow id="Flow_05" sourceRef="Task_collect_kit" targetRef="Gateway_revoke_join" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_revoke_join" targetRef="Gateway_leaver_type" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_leaver_type" targetRef="Task_exit_interview" name="voluntary">
      <conditionExpression xsi:type="tFormalExpression">leaver_type == 'voluntary'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_08" sourceRef="Gateway_leaver_type" targetRef="Task_notify_legal" name="involuntary" />
    <sequenceFlow id="Flow_09" sourceRef="Task_exit_interview" targetRef="Gateway_leaver_type_join" />
    <sequenceFlow id="Flow_10" sourceRef="Task_notify_legal" targetRef="Gateway_leaver_type_join" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_leaver_type_join" targetRef="Task_archive_mailbox" />
    <sequenceFlow id="Flow_12" sourceRef="Task_archive_mailbox" targetRef="EndEvent_offboarded" />
  </process>
</definitions>
