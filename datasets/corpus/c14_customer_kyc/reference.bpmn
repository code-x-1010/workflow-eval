<?xml version="1.0" encoding="UTF-8"?>
<!-- c14_customer_kyc - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_customer_kyc" targetNamespace="http://uipath.com/maestro">
  <process id="Process_customer_kyc" isExecutable="true">
    <startEvent id="StartEvent_signup" name="Customer signs up" />
    <serviceTask id="Task_verify_id" name="Verify identity document" />
    <serviceTask id="Task_screen" name="Screen against PEP and sanctions lists" />
    <exclusiveGateway id="Gateway_risk_band" name="Risk band?" default="Flow_08" />
    <sendTask id="Task_report_mlro" name="Report case to MLRO" />
    <endEvent id="EndEvent_refused" name="Customer refused">
      <terminateEventDefinition />
    </endEvent>
    <userTask id="Task_analyst_review" name="Compliance analyst review" />
    <exclusiveGateway id="Gateway_risk_band_join" />
    <serviceTask id="Task_open_account" name="Open account" />
    <endEvent id="EndEvent_kyc_done" name="Customer onboarded" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_signup" targetRef="Task_verify_id" />
    <sequenceFlow id="Flow_02" sourceRef="Task_verify_id" targetRef="Task_screen" />
    <sequenceFlow id="Flow_03" sourceRef="Task_screen" targetRef="Gateway_risk_band" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_risk_band" targetRef="Task_report_mlro" name="high">
      <conditionExpression xsi:type="tFormalExpression">risk_band == 'high'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_report_mlro" targetRef="EndEvent_refused" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_risk_band" targetRef="Task_analyst_review" name="medium">
      <conditionExpression xsi:type="tFormalExpression">risk_band == 'medium'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_07" sourceRef="Task_analyst_review" targetRef="Gateway_risk_band_join" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_risk_band" targetRef="Gateway_risk_band_join" name="low" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_risk_band_join" targetRef="Task_open_account" />
    <sequenceFlow id="Flow_10" sourceRef="Task_open_account" targetRef="EndEvent_kyc_done" />
  </process>
</definitions>
