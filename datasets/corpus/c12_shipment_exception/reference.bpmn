<?xml version="1.0" encoding="UTF-8"?>
<!-- c12_shipment_exception - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_shipment_exception" targetNamespace="http://uipath.com/maestro">
  <process id="Process_shipment_exception" isExecutable="true">
    <startEvent id="StartEvent_exception" name="Carrier reports exception">
      <messageEventDefinition />
    </startEvent>
    <serviceTask id="Task_rebook" name="Attempt automatic re-booking" />
    <exclusiveGateway id="Gateway_rebooked" name="Re-booking succeeded?" default="Flow_03" />
    <exclusiveGateway id="Gateway_attempts" name="Attempts remaining?" default="Flow_06" />
    <serviceTask id="Task_wait" name="Wait before retry" />
    <userTask id="Task_coordinator" name="Logistics coordinator resolves" />
    <exclusiveGateway id="Gateway_rebooked_join" />
    <sendTask id="Task_update_customer" name="Update customer" />
    <endEvent id="EndEvent_resolved" name="Exception resolved" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_exception" targetRef="Task_rebook" />
    <sequenceFlow id="Flow_02" sourceRef="Task_rebook" targetRef="Gateway_rebooked" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_rebooked" targetRef="Gateway_attempts" name="failed" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_attempts" targetRef="Task_wait" name="retry">
      <conditionExpression xsi:type="tFormalExpression">attempts &lt; 3</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_wait" targetRef="Task_rebook" name="retry" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_attempts" targetRef="Task_coordinator" name="give up" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_rebooked" targetRef="Gateway_rebooked_join" name="succeeded">
      <conditionExpression xsi:type="tFormalExpression">rebooked == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_08" sourceRef="Task_coordinator" targetRef="Gateway_rebooked_join" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_rebooked_join" targetRef="Task_update_customer" />
    <sequenceFlow id="Flow_10" sourceRef="Task_update_customer" targetRef="EndEvent_resolved" />
  </process>
</definitions>
