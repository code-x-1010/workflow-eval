<?xml version="1.0" encoding="UTF-8"?>
<!-- u07_until_its_sorted - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. ONE reasonable reading of an under-specified prompt - not ground truth. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_status_polling" targetNamespace="http://uipath.com/maestro">
  <process id="Process_status_polling" isExecutable="true">
    <startEvent id="StartEvent_polling" name="Polling started" />
    <serviceTask id="Task_check_status" name="Check status" />
    <exclusiveGateway id="Gateway_sorted" name="Sorted?" default="Flow_05" />
    <serviceTask id="Task_wait_poll" name="Wait before checking again" />
    <endEvent id="EndEvent_sorted" name="Status sorted" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_polling" targetRef="Task_check_status" />
    <sequenceFlow id="Flow_02" sourceRef="Task_check_status" targetRef="Gateway_sorted" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_sorted" targetRef="Task_wait_poll" name="not yet">
      <conditionExpression xsi:type="tFormalExpression">sorted == false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_wait_poll" targetRef="Task_check_status" name="check again" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_sorted" targetRef="EndEvent_sorted" name="sorted" />
  </process>
</definitions>
