<?xml version="1.0" encoding="UTF-8"?>
<!-- c15_loan_application - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_loan_application" targetNamespace="http://uipath.com/maestro">
  <process id="Process_loan_application" isExecutable="true">
    <startEvent id="StartEvent_loan_application" name="Loan application submitted" />
    <serviceTask id="Task_credit_file" name="Pull credit file" />
    <boundaryEvent id="Boundary_bureau_down" attachedToRef="Task_credit_file" name="Credit bureau unreachable">
      <errorEventDefinition />
    </boundaryEvent>
    <serviceTask id="Task_park_application" name="Park application" />
    <sendTask id="Task_holding_notice" name="Send holding notice to applicant" />
    <endEvent id="EndEvent_parked" name="Application parked" />
    <businessRuleTask id="Task_affordability" name="Run affordability rules" />
    <exclusiveGateway id="Gateway_passed" name="Rules passed?" default="Flow_09" />
    <sendTask id="Task_decline_letter" name="Send decline letter" />
    <endEvent id="EndEvent_declined" name="Application declined" />
    <exclusiveGateway id="Gateway_loan_amount" name="Loan over 25000?" default="Flow_12" />
    <userTask id="Task_underwriter" name="Underwriter review" />
    <exclusiveGateway id="Gateway_loan_amount_join" />
    <sendTask id="Task_decision_letter" name="Send decision letter" />
    <endEvent id="EndEvent_decided" name="Application decided" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_loan_application" targetRef="Task_credit_file" />
    <sequenceFlow id="Flow_02" sourceRef="Boundary_bureau_down" targetRef="Task_park_application" />
    <sequenceFlow id="Flow_03" sourceRef="Task_park_application" targetRef="Task_holding_notice" />
    <sequenceFlow id="Flow_04" sourceRef="Task_holding_notice" targetRef="EndEvent_parked" />
    <sequenceFlow id="Flow_05" sourceRef="Task_credit_file" targetRef="Task_affordability" />
    <sequenceFlow id="Flow_06" sourceRef="Task_affordability" targetRef="Gateway_passed" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_passed" targetRef="Task_decline_letter" name="failed">
      <conditionExpression xsi:type="tFormalExpression">affordability_passed == false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_08" sourceRef="Task_decline_letter" targetRef="EndEvent_declined" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_passed" targetRef="Gateway_loan_amount" name="passed" />
    <sequenceFlow id="Flow_10" sourceRef="Gateway_loan_amount" targetRef="Task_underwriter" name="over 25000">
      <conditionExpression xsi:type="tFormalExpression">loan_amount &gt; 25000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_11" sourceRef="Task_underwriter" targetRef="Gateway_loan_amount_join" />
    <sequenceFlow id="Flow_12" sourceRef="Gateway_loan_amount" targetRef="Gateway_loan_amount_join" name="25000 or less" />
    <sequenceFlow id="Flow_13" sourceRef="Gateway_loan_amount_join" targetRef="Task_decision_letter" />
    <sequenceFlow id="Flow_14" sourceRef="Task_decision_letter" targetRef="EndEvent_decided" />
  </process>
</definitions>
