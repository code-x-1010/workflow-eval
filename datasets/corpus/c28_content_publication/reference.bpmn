<?xml version="1.0" encoding="UTF-8"?>
<!-- c28_content_publication - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_content_publication" targetNamespace="http://uipath.com/maestro">
  <process id="Process_content_publication" isExecutable="true">
    <startEvent id="StartEvent_draft" name="Draft submitted" />
    <userTask id="Task_editor_review" name="Editor reviews draft" />
    <exclusiveGateway id="Gateway_editor" name="Editor approves?" default="Flow_05" />
    <userTask id="Task_revise" name="Writer revises draft" />
    <exclusiveGateway id="Gateway_customer_named" name="Names a customer?" default="Flow_08" />
    <userTask id="Task_legal_check" name="Legal check" />
    <exclusiveGateway id="Gateway_customer_named_join" />
    <serviceTask id="Task_publish" name="Publish to site" />
    <sendTask id="Task_social" name="Post link to social" />
    <endEvent id="EndEvent_published" name="Content published" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_draft" targetRef="Task_editor_review" />
    <sequenceFlow id="Flow_02" sourceRef="Task_editor_review" targetRef="Gateway_editor" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_editor" targetRef="Task_revise" name="rework">
      <conditionExpression xsi:type="tFormalExpression">editor_decision == 'rework'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_revise" targetRef="Task_editor_review" name="resubmit" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_editor" targetRef="Gateway_customer_named" name="approved" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_customer_named" targetRef="Task_legal_check" name="names a customer">
      <conditionExpression xsi:type="tFormalExpression">mentions_customer == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_07" sourceRef="Task_legal_check" targetRef="Gateway_customer_named_join" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_customer_named" targetRef="Gateway_customer_named_join" name="no customer named" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_customer_named_join" targetRef="Task_publish" />
    <sequenceFlow id="Flow_10" sourceRef="Task_publish" targetRef="Task_social" />
    <sequenceFlow id="Flow_11" sourceRef="Task_social" targetRef="EndEvent_published" />
  </process>
</definitions>
