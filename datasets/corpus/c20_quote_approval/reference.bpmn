<?xml version="1.0" encoding="UTF-8"?>
<!-- c20_quote_approval - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_quote_approval" targetNamespace="http://uipath.com/maestro">
  <process id="Process_quote_approval" isExecutable="true">
    <startEvent id="StartEvent_quote" name="Quote built" />
    <serviceTask id="Task_calc_discount" name="Calculate discount percentage" />
    <exclusiveGateway id="Gateway_discount" name="Discount band?" default="Flow_04" />
    <userTask id="Task_manager_approve" name="Sales manager approval" />
    <userTask id="Task_vp_approve" name="VP of sales approval" />
    <exclusiveGateway id="Gateway_discount_join" />
    <exclusiveGateway id="Gateway_approved" name="Approved?" default="Flow_11" />
    <sendTask id="Task_return_to_rep" name="Return to rep with reason" />
    <endEvent id="EndEvent_quote_rejected" name="Quote rejected" />
    <sendTask id="Task_send_quote" name="Send quote to customer" />
    <serviceTask id="Task_update_crm" name="Update CRM opportunity" />
    <endEvent id="EndEvent_quote_sent" name="Quote sent" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_quote" targetRef="Task_calc_discount" />
    <sequenceFlow id="Flow_02" sourceRef="Task_calc_discount" targetRef="Gateway_discount" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_discount" targetRef="Task_manager_approve" name="10 to 25 percent">
      <conditionExpression xsi:type="tFormalExpression">discount_pct &lt;= 25</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Gateway_discount" targetRef="Task_vp_approve" name="over 25 percent" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_discount" targetRef="Gateway_discount_join" name="10 percent or less">
      <conditionExpression xsi:type="tFormalExpression">discount_pct &lt;= 10</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_06" sourceRef="Task_manager_approve" targetRef="Gateway_discount_join" />
    <sequenceFlow id="Flow_07" sourceRef="Task_vp_approve" targetRef="Gateway_discount_join" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_discount_join" targetRef="Gateway_approved" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_approved" targetRef="Task_return_to_rep" name="rejected">
      <conditionExpression xsi:type="tFormalExpression">approved == false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_10" sourceRef="Task_return_to_rep" targetRef="EndEvent_quote_rejected" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_approved" targetRef="Task_send_quote" name="approved" />
    <sequenceFlow id="Flow_12" sourceRef="Task_send_quote" targetRef="Task_update_crm" />
    <sequenceFlow id="Flow_13" sourceRef="Task_update_crm" targetRef="EndEvent_quote_sent" />
  </process>
</definitions>
