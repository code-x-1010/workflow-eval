<?xml version="1.0" encoding="UTF-8"?>
<!-- c01_invoice_approval - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_invoice_approval" targetNamespace="http://uipath.com/maestro">
  <process id="Process_invoice_approval" isExecutable="true">
    <startEvent id="StartEvent_invoice" name="Invoice received by email">
      <messageEventDefinition />
    </startEvent>
    <serviceTask id="Task_extract" name="Extract vendor, amount and line items" />
    <exclusiveGateway id="Gateway_amount" name="Amount over 10000?" default="Flow_04" />
    <userTask id="Task_approval" name="Manager approval" />
    <serviceTask id="Task_autopay" name="Auto-pay invoice" />
    <boundaryEvent id="Boundary_payment_failed" attachedToRef="Task_autopay" name="Payment API failed">
      <errorEventDefinition />
    </boundaryEvent>
    <userTask id="Task_park" name="Park for finance review" />
    <endEvent id="EndEvent_parked" name="Parked for review" />
    <exclusiveGateway id="Gateway_amount_join" />
    <sendTask id="Task_notify" name="Notify vendor of settlement" />
    <endEvent id="EndEvent_settled" name="Invoice settled" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_invoice" targetRef="Task_extract" />
    <sequenceFlow id="Flow_02" sourceRef="Task_extract" targetRef="Gateway_amount" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_amount" targetRef="Task_approval" name="over">
      <conditionExpression xsi:type="tFormalExpression">amount &gt; 10000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Gateway_amount" targetRef="Task_autopay" name="under" />
    <sequenceFlow id="Flow_05" sourceRef="Boundary_payment_failed" targetRef="Task_park" />
    <sequenceFlow id="Flow_06" sourceRef="Task_park" targetRef="EndEvent_parked" />
    <sequenceFlow id="Flow_07" sourceRef="Task_approval" targetRef="Gateway_amount_join" />
    <sequenceFlow id="Flow_08" sourceRef="Task_autopay" targetRef="Gateway_amount_join" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_amount_join" targetRef="Task_notify" />
    <sequenceFlow id="Flow_10" sourceRef="Task_notify" targetRef="EndEvent_settled" />
  </process>
</definitions>
