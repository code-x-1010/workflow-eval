<?xml version="1.0" encoding="UTF-8"?>
<!-- c16_insurance_claim - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_insurance_claim" targetNamespace="http://uipath.com/maestro">
  <process id="Process_insurance_claim" isExecutable="true">
    <startEvent id="StartEvent_claim_filed" name="Claim filed" />
    <serviceTask id="Task_classify_document" name="Classify supporting document">
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopDataInputRef>documents</loopDataInputRef>
      </multiInstanceLoopCharacteristics>
    </serviceTask>
    <exclusiveGateway id="Gateway_policy" name="Policy in force?" default="Flow_05" />
    <sendTask id="Task_decline_claim" name="Decline claim" />
    <endEvent id="EndEvent_claim_declined" name="Claim declined" />
    <serviceTask id="Task_fraud_score" name="Score claim for fraud" />
    <exclusiveGateway id="Gateway_fraud" name="Fraud score over 0.8?" default="Flow_09" />
    <userTask id="Task_siu" name="Special investigations unit review" />
    <endEvent id="EndEvent_siu" name="Referred to SIU" />
    <exclusiveGateway id="Gateway_claim_value" name="Claim over 5000?" default="Flow_12" />
    <userTask id="Task_handler_assess" name="Claims handler assessment" />
    <exclusiveGateway id="Gateway_claim_value_join" />
    <serviceTask id="Task_settle" name="Settle claim" />
    <endEvent id="EndEvent_settled" name="Claim settled" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_claim_filed" targetRef="Task_classify_document" />
    <sequenceFlow id="Flow_02" sourceRef="Task_classify_document" targetRef="Gateway_policy" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_policy" targetRef="Task_decline_claim" name="lapsed">
      <conditionExpression xsi:type="tFormalExpression">policy_in_force == false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_decline_claim" targetRef="EndEvent_claim_declined" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_policy" targetRef="Task_fraud_score" name="in force" />
    <sequenceFlow id="Flow_06" sourceRef="Task_fraud_score" targetRef="Gateway_fraud" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_fraud" targetRef="Task_siu" name="suspected fraud">
      <conditionExpression xsi:type="tFormalExpression">fraud_score &gt; 0.8</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_08" sourceRef="Task_siu" targetRef="EndEvent_siu" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_fraud" targetRef="Gateway_claim_value" name="clear" />
    <sequenceFlow id="Flow_10" sourceRef="Gateway_claim_value" targetRef="Task_handler_assess" name="over 5000">
      <conditionExpression xsi:type="tFormalExpression">claim_amount &gt; 5000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_11" sourceRef="Task_handler_assess" targetRef="Gateway_claim_value_join" />
    <sequenceFlow id="Flow_12" sourceRef="Gateway_claim_value" targetRef="Gateway_claim_value_join" name="5000 or less" />
    <sequenceFlow id="Flow_13" sourceRef="Gateway_claim_value_join" targetRef="Task_settle" />
    <sequenceFlow id="Flow_14" sourceRef="Task_settle" targetRef="EndEvent_settled" />
  </process>
</definitions>
