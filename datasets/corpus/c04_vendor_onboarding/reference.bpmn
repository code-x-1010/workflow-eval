<?xml version="1.0" encoding="UTF-8"?>
<!-- c04_vendor_onboarding - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_vendor_onboarding" targetNamespace="http://uipath.com/maestro">
  <process id="Process_vendor_onboarding" isExecutable="true">
    <startEvent id="StartEvent_vendor_form" name="Vendor form submitted" />
    <parallelGateway id="Gateway_checks" name="Run checks in parallel" />
    <serviceTask id="Task_credit_check" name="Credit check" />
    <serviceTask id="Task_sanctions" name="Sanctions screening" />
    <parallelGateway id="Gateway_checks_join" />
    <userTask id="Task_officer_review" name="Procurement officer review" />
    <exclusiveGateway id="Gateway_decision" name="Vendor approved?" default="Flow_11" />
    <serviceTask id="Task_create_erp" name="Create vendor in ERP" />
    <sendTask id="Task_send_code" name="Email supplier code to vendor" />
    <endEvent id="EndEvent_onboarded" name="Vendor onboarded" />
    <sendTask id="Task_reject_notice" name="Email rejection with reason" />
    <endEvent id="EndEvent_vendor_rejected" name="Vendor rejected" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_vendor_form" targetRef="Gateway_checks" />
    <sequenceFlow id="Flow_02" sourceRef="Gateway_checks" targetRef="Task_credit_check" name="credit" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_checks" targetRef="Task_sanctions" name="sanctions" />
    <sequenceFlow id="Flow_04" sourceRef="Task_credit_check" targetRef="Gateway_checks_join" />
    <sequenceFlow id="Flow_05" sourceRef="Task_sanctions" targetRef="Gateway_checks_join" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_checks_join" targetRef="Task_officer_review" />
    <sequenceFlow id="Flow_07" sourceRef="Task_officer_review" targetRef="Gateway_decision" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_decision" targetRef="Task_create_erp" name="approved">
      <conditionExpression xsi:type="tFormalExpression">decision == 'approved'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_09" sourceRef="Task_create_erp" targetRef="Task_send_code" />
    <sequenceFlow id="Flow_10" sourceRef="Task_send_code" targetRef="EndEvent_onboarded" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_decision" targetRef="Task_reject_notice" name="rejected" />
    <sequenceFlow id="Flow_12" sourceRef="Task_reject_notice" targetRef="EndEvent_vendor_rejected" />
  </process>
</definitions>
