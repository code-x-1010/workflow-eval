<?xml version="1.0" encoding="UTF-8"?>
<!-- c09_support_ticket_triage - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_ticket_triage" targetNamespace="http://uipath.com/maestro">
  <process id="Process_ticket_triage" isExecutable="true">
    <startEvent id="StartEvent_ticket" name="Ticket received" />
    <serviceTask id="Task_classify" name="Classify severity" />
    <serviceTask id="Task_track" name="Write tracking record" />
    <exclusiveGateway id="Gateway_severity" name="Severity?" default="Flow_10" />
    <parallelGateway id="Gateway_p1" name="Page and open channel" />
    <sendTask id="Task_page_oncall" name="Page on-call engineer" />
    <serviceTask id="Task_open_channel" name="Open incident channel" />
    <parallelGateway id="Gateway_p1_join" />
    <serviceTask id="Task_assign_duty" name="Assign to duty queue" />
    <sendTask id="Task_ack" name="Send acknowledgement email" />
    <exclusiveGateway id="Gateway_severity_join" />
    <endEvent id="EndEvent_routed" name="Ticket routed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_ticket" targetRef="Task_classify" />
    <sequenceFlow id="Flow_02" sourceRef="Task_classify" targetRef="Task_track" />
    <sequenceFlow id="Flow_03" sourceRef="Task_track" targetRef="Gateway_severity" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_severity" targetRef="Gateway_p1" name="P1">
      <conditionExpression xsi:type="tFormalExpression">severity == 'P1'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Gateway_p1" targetRef="Task_page_oncall" name="page" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_p1" targetRef="Task_open_channel" name="channel" />
    <sequenceFlow id="Flow_07" sourceRef="Task_page_oncall" targetRef="Gateway_p1_join" />
    <sequenceFlow id="Flow_08" sourceRef="Task_open_channel" targetRef="Gateway_p1_join" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_severity" targetRef="Task_assign_duty" name="P2">
      <conditionExpression xsi:type="tFormalExpression">severity == 'P2'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_10" sourceRef="Gateway_severity" targetRef="Task_ack" name="P3 or lower" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_p1_join" targetRef="Gateway_severity_join" />
    <sequenceFlow id="Flow_12" sourceRef="Task_assign_duty" targetRef="Gateway_severity_join" />
    <sequenceFlow id="Flow_13" sourceRef="Task_ack" targetRef="Gateway_severity_join" />
    <sequenceFlow id="Flow_14" sourceRef="Gateway_severity_join" targetRef="EndEvent_routed" />
  </process>
</definitions>
