<?xml version="1.0" encoding="UTF-8"?>
<!-- c19_lead_qualification - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_lead_qualification" targetNamespace="http://uipath.com/maestro">
  <process id="Process_lead_qualification" isExecutable="true">
    <startEvent id="StartEvent_lead" name="Lead submits web form" />
    <serviceTask id="Task_enrich" name="Enrich lead from data provider" />
    <exclusiveGateway id="Gateway_existing" name="Existing customer?" default="Flow_05" />
    <serviceTask id="Task_route_am" name="Route to account manager" />
    <endEvent id="EndEvent_routed_am" name="Routed to account manager" />
    <serviceTask id="Task_score_fit" name="Score lead for fit" />
    <exclusiveGateway id="Gateway_fit" name="Fit score 60 or more?" default="Flow_09" />
    <serviceTask id="Task_assign_ae" name="Assign to account executive" />
    <sendTask id="Task_meeting_invite" name="Send meeting invite" />
    <serviceTask id="Task_nurture" name="Add to nurture sequence" />
    <exclusiveGateway id="Gateway_fit_join" />
    <endEvent id="EndEvent_lead_handled" name="Lead handled" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_lead" targetRef="Task_enrich" />
    <sequenceFlow id="Flow_02" sourceRef="Task_enrich" targetRef="Gateway_existing" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_existing" targetRef="Task_route_am" name="existing">
      <conditionExpression xsi:type="tFormalExpression">is_existing_customer == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_route_am" targetRef="EndEvent_routed_am" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_existing" targetRef="Task_score_fit" name="new business" />
    <sequenceFlow id="Flow_06" sourceRef="Task_score_fit" targetRef="Gateway_fit" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_fit" targetRef="Task_assign_ae" name="60 or more">
      <conditionExpression xsi:type="tFormalExpression">fit_score &gt;= 60</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_08" sourceRef="Task_assign_ae" targetRef="Task_meeting_invite" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_fit" targetRef="Task_nurture" name="below 60" />
    <sequenceFlow id="Flow_10" sourceRef="Task_meeting_invite" targetRef="Gateway_fit_join" />
    <sequenceFlow id="Flow_11" sourceRef="Task_nurture" targetRef="Gateway_fit_join" />
    <sequenceFlow id="Flow_12" sourceRef="Gateway_fit_join" targetRef="EndEvent_lead_handled" />
  </process>
</definitions>
