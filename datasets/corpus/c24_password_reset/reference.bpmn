<?xml version="1.0" encoding="UTF-8"?>
<!-- c24_password_reset - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_password_reset" targetNamespace="http://uipath.com/maestro">
  <process id="Process_password_reset" isExecutable="true">
    <startEvent id="StartEvent_reset_request" name="Password reset requested" />
    <sendTask id="Task_send_otp" name="Send one-time code to registered phone" />
    <userTask id="Task_collect_otp" name="Collect code from user" />
    <exclusiveGateway id="Gateway_otp" name="Code correct?" default="Flow_07" />
    <serviceTask id="Task_lock_request" name="Lock reset request" />
    <sendTask id="Task_tell_servicedesk" name="Tell user to contact service desk" />
    <endEvent id="EndEvent_locked" name="Request locked" />
    <serviceTask id="Task_reset_password" name="Reset password" />
    <serviceTask id="Task_force_change" name="Force change at next logon" />
    <sendTask id="Task_confirm_reset" name="Email confirmation" />
    <endEvent id="EndEvent_reset_done" name="Password reset" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_reset_request" targetRef="Task_send_otp" />
    <sequenceFlow id="Flow_02" sourceRef="Task_send_otp" targetRef="Task_collect_otp" />
    <sequenceFlow id="Flow_03" sourceRef="Task_collect_otp" targetRef="Gateway_otp" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_otp" targetRef="Task_lock_request" name="incorrect">
      <conditionExpression xsi:type="tFormalExpression">otp_valid == false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_lock_request" targetRef="Task_tell_servicedesk" />
    <sequenceFlow id="Flow_06" sourceRef="Task_tell_servicedesk" targetRef="EndEvent_locked" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_otp" targetRef="Task_reset_password" name="correct" />
    <sequenceFlow id="Flow_08" sourceRef="Task_reset_password" targetRef="Task_force_change" />
    <sequenceFlow id="Flow_09" sourceRef="Task_force_change" targetRef="Task_confirm_reset" />
    <sequenceFlow id="Flow_10" sourceRef="Task_confirm_reset" targetRef="EndEvent_reset_done" />
  </process>
</definitions>
