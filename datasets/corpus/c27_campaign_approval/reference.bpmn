<?xml version="1.0" encoding="UTF-8"?>
<!-- c27_campaign_approval - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_campaign_approval" targetNamespace="http://uipath.com/maestro">
  <process id="Process_campaign_approval" isExecutable="true">
    <startEvent id="StartEvent_brief" name="Campaign brief submitted" />
    <userTask id="Task_brand_review" name="Brand reviews creative" />
    <exclusiveGateway id="Gateway_spend" name="Spend 20000 or more?" default="Flow_05" />
    <userTask id="Task_cmo_signoff" name="CMO signs off budget" />
    <exclusiveGateway id="Gateway_spend_join" />
    <serviceTask id="Task_schedule_campaign" name="Schedule campaign" />
    <serviceTask id="Task_book_spend" name="Book spend against department budget" />
    <endEvent id="EndEvent_campaign_live" name="Campaign scheduled" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_brief" targetRef="Task_brand_review" />
    <sequenceFlow id="Flow_02" sourceRef="Task_brand_review" targetRef="Gateway_spend" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_spend" targetRef="Task_cmo_signoff" name="20000 or more">
      <conditionExpression xsi:type="tFormalExpression">spend &gt;= 20000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_cmo_signoff" targetRef="Gateway_spend_join" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_spend" targetRef="Gateway_spend_join" name="under 20000" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_spend_join" targetRef="Task_schedule_campaign" />
    <sequenceFlow id="Flow_07" sourceRef="Task_schedule_campaign" targetRef="Task_book_spend" />
    <sequenceFlow id="Flow_08" sourceRef="Task_book_spend" targetRef="EndEvent_campaign_live" />
  </process>
</definitions>
