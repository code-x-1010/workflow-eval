<?xml version="1.0" encoding="UTF-8"?>
<!-- c17_contract_review - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_contract_review" targetNamespace="http://uipath.com/maestro">
  <process id="Process_contract_review" isExecutable="true">
    <startEvent id="StartEvent_contract_returned" name="Counterparty returns contract">
      <messageEventDefinition />
    </startEvent>
    <serviceTask id="Task_extract_clauses" name="Extract changed clauses" />
    <userTask id="Task_counsel_review" name="Counsel reviews clauses" />
    <exclusiveGateway id="Gateway_redlines" name="Redlines raised?" default="Flow_07" />
    <sendTask id="Task_send_redlines" name="Send redlines to counterparty" />
    <receiveTask id="Task_await_version" name="Await next version" />
    <userTask id="Task_signature" name="Route for signature" />
    <serviceTask id="Task_file" name="File executed contract" />
    <endEvent id="EndEvent_executed" name="Contract executed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_contract_returned" targetRef="Task_extract_clauses" />
    <sequenceFlow id="Flow_02" sourceRef="Task_extract_clauses" targetRef="Task_counsel_review" />
    <sequenceFlow id="Flow_03" sourceRef="Task_counsel_review" targetRef="Gateway_redlines" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_redlines" targetRef="Task_send_redlines" name="redlines">
      <conditionExpression xsi:type="tFormalExpression">redlines_raised == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_send_redlines" targetRef="Task_await_version" />
    <sequenceFlow id="Flow_06" sourceRef="Task_await_version" targetRef="Task_extract_clauses" name="next version" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_redlines" targetRef="Task_signature" name="clean" />
    <sequenceFlow id="Flow_08" sourceRef="Task_signature" targetRef="Task_file" />
    <sequenceFlow id="Flow_09" sourceRef="Task_file" targetRef="EndEvent_executed" />
  </process>
</definitions>
