<?xml version="1.0" encoding="UTF-8"?>
<!-- u08_contradictory_discounts - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. ONE reasonable reading of an under-specified prompt - not ground truth. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_discount_approval" targetNamespace="http://uipath.com/maestro">
  <process id="Process_discount_approval" isExecutable="true">
    <startEvent id="StartEvent_discount" name="Discount requested" />
    <exclusiveGateway id="Gateway_discount_pct" name="Discount over 10%?" default="Flow_03" />
    <userTask id="Task_sales_manager" name="Sales manager sign-off" />
    <serviceTask id="Task_auto_approve" name="Auto-approve discount" />
    <exclusiveGateway id="Gateway_discount_pct_join" />
    <serviceTask id="Task_apply_discount" name="Apply discount to deal" />
    <endEvent id="EndEvent_discount_applied" name="Discount applied" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_discount" targetRef="Gateway_discount_pct" />
    <sequenceFlow id="Flow_02" sourceRef="Gateway_discount_pct" targetRef="Task_sales_manager" name="over 10 percent">
      <conditionExpression xsi:type="tFormalExpression">discount_pct &gt; 10</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_03" sourceRef="Gateway_discount_pct" targetRef="Task_auto_approve" name="10 percent or less" />
    <sequenceFlow id="Flow_04" sourceRef="Task_sales_manager" targetRef="Gateway_discount_pct_join" />
    <sequenceFlow id="Flow_05" sourceRef="Task_auto_approve" targetRef="Gateway_discount_pct_join" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_discount_pct_join" targetRef="Task_apply_discount" />
    <sequenceFlow id="Flow_07" sourceRef="Task_apply_discount" targetRef="EndEvent_discount_applied" />
  </process>
</definitions>
