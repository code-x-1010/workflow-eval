<!-- u02_big_orders - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. ONE reasonable reading of an under-specified prompt - not ground truth. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_big_orders" targetNamespace="http://uipath.com/maestro">
  <process id="Process_big_orders" isExecutable="true">
    <startEvent id="StartEvent_order" name="Order received" />
    <exclusiveGateway id="Gateway_size" name="Big order?" default="Flow_04" />
    <userTask id="Task_manager_review" name="Manager reviews order" />
    <exclusiveGateway id="Gateway_size_join" />
    <serviceTask id="Task_process_order" name="Process order" />
    <endEvent id="EndEvent_order_done" name="Order processed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_order" targetRef="Gateway_size" />
    <sequenceFlow id="Flow_02" sourceRef="Gateway_size" targetRef="Task_manager_review" name="big">
      <conditionExpression xsi:type="tFormalExpression">order_is_big == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_03" sourceRef="Task_manager_review" targetRef="Gateway_size_join" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_size" targetRef="Gateway_size_join" name="small" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_size_join" targetRef="Task_process_order" />
    <sequenceFlow id="Flow_06" sourceRef="Task_process_order" targetRef="EndEvent_order_done" />
  </process>
</definitions>
