<?xml version="1.0" encoding="UTF-8"?>
<!-- u09_urgent_tickets - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. ONE reasonable reading of an under-specified prompt - not ground truth. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_urgent_tickets" targetNamespace="http://uipath.com/maestro">
  <process id="Process_urgent_tickets" isExecutable="true">
    <startEvent id="StartEvent_ticket_in" name="Ticket received" />
    <exclusiveGateway id="Gateway_urgent" name="Urgent?" default="Flow_03" />
    <sendTask id="Task_escalate" name="Escalate ticket" />
    <serviceTask id="Task_queue" name="Add to standard queue" />
    <exclusiveGateway id="Gateway_urgent_join" />
    <endEvent id="EndEvent_ticket_routed" name="Ticket routed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_ticket_in" targetRef="Gateway_urgent" />
    <sequenceFlow id="Flow_02" sourceRef="Gateway_urgent" targetRef="Task_escalate" name="urgent">
      <conditionExpression xsi:type="tFormalExpression">is_urgent == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_03" sourceRef="Gateway_urgent" targetRef="Task_queue" name="not urgent" />
    <sequenceFlow id="Flow_04" sourceRef="Task_escalate" targetRef="Gateway_urgent_join" />
    <sequenceFlow id="Flow_05" sourceRef="Task_queue" targetRef="Gateway_urgent_join" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_urgent_join" targetRef="EndEvent_ticket_routed" />
  </process>
</definitions>
