<?xml version="1.0" encoding="UTF-8"?>
<!-- c10_refund_request - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_refund_request" targetNamespace="http://uipath.com/maestro">
  <process id="Process_refund_request" isExecutable="true">
    <startEvent id="StartEvent_refund_request" name="Refund requested" />
    <serviceTask id="Task_load_order" name="Load original order" />
    <exclusiveGateway id="Gateway_window" name="Within 30 day window?" default="Flow_05" />
    <sendTask id="Task_decline_refund" name="Decline and explain" />
    <endEvent id="EndEvent_declined" name="Refund declined" />
    <exclusiveGateway id="Gateway_refund_amount" name="Refund over 250?" default="Flow_08" />
    <userTask id="Task_lead_approval" name="Support lead approval" />
    <exclusiveGateway id="Gateway_refund_amount_join" />
    <serviceTask id="Task_process_refund" name="Process refund with provider" />
    <boundaryEvent id="Boundary_refund_rejected" attachedToRef="Task_process_refund" name="Provider rejected refund">
      <errorEventDefinition />
    </boundaryEvent>
    <serviceTask id="Task_finance_ticket" name="Raise finance ticket" />
    <endEvent id="EndEvent_finance_ticket" name="Escalated to finance" />
    <sendTask id="Task_confirm_refund" name="Confirm outcome to customer" />
    <endEvent id="EndEvent_refunded" name="Refund complete" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_refund_request" targetRef="Task_load_order" />
    <sequenceFlow id="Flow_02" sourceRef="Task_load_order" targetRef="Gateway_window" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_window" targetRef="Task_decline_refund" name="outside window">
      <conditionExpression xsi:type="tFormalExpression">days_since_order &gt; 30</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_decline_refund" targetRef="EndEvent_declined" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_window" targetRef="Gateway_refund_amount" name="within window" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_refund_amount" targetRef="Task_lead_approval" name="over 250">
      <conditionExpression xsi:type="tFormalExpression">refund_amount &gt; 250</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_07" sourceRef="Task_lead_approval" targetRef="Gateway_refund_amount_join" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_refund_amount" targetRef="Gateway_refund_amount_join" name="250 or less" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_refund_amount_join" targetRef="Task_process_refund" />
    <sequenceFlow id="Flow_10" sourceRef="Boundary_refund_rejected" targetRef="Task_finance_ticket" />
    <sequenceFlow id="Flow_11" sourceRef="Task_finance_ticket" targetRef="EndEvent_finance_ticket" />
    <sequenceFlow id="Flow_12" sourceRef="Task_process_refund" targetRef="Task_confirm_refund" />
    <sequenceFlow id="Flow_13" sourceRef="Task_confirm_refund" targetRef="EndEvent_refunded" />
  </process>
</definitions>
