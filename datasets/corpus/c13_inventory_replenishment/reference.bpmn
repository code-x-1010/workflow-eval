<?xml version="1.0" encoding="UTF-8"?>
<!-- c13_inventory_replenishment - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_inventory_replenishment" targetNamespace="http://uipath.com/maestro">
  <process id="Process_inventory_replenishment" isExecutable="true">
    <startEvent id="StartEvent_nightly" name="Nightly at 2am">
      <timerEventDefinition>
        <timeCycle>0 0 2 * * ?</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <serviceTask id="Task_load_catalogue" name="Load catalogue" />
    <serviceTask id="Task_check_sku" name="Check SKU against reorder point">
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopDataInputRef>skus</loopDataInputRef>
      </multiInstanceLoopCharacteristics>
    </serviceTask>
    <exclusiveGateway id="Gateway_below" name="Any SKU below reorder point?" default="Flow_06" />
    <serviceTask id="Task_raise_replenishment" name="Raise replenishment order">
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopDataInputRef>skus_below_reorder_point</loopDataInputRef>
      </multiInstanceLoopCharacteristics>
    </serviceTask>
    <exclusiveGateway id="Gateway_below_join" />
    <sendTask id="Task_summary" name="Email summary to warehouse manager" />
    <endEvent id="EndEvent_replenished" name="Replenishment run complete" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_nightly" targetRef="Task_load_catalogue" />
    <sequenceFlow id="Flow_02" sourceRef="Task_load_catalogue" targetRef="Task_check_sku" />
    <sequenceFlow id="Flow_03" sourceRef="Task_check_sku" targetRef="Gateway_below" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_below" targetRef="Task_raise_replenishment" name="below">
      <conditionExpression xsi:type="tFormalExpression">skus_below_reorder_point | length &gt; 0</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_raise_replenishment" targetRef="Gateway_below_join" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_below" targetRef="Gateway_below_join" name="none" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_below_join" targetRef="Task_summary" />
    <sequenceFlow id="Flow_08" sourceRef="Task_summary" targetRef="EndEvent_replenished" />
  </process>
</definitions>
