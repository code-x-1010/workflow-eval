<?xml version="1.0" encoding="UTF-8"?>
<!-- c07_leave_request - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_leave_request" targetNamespace="http://uipath.com/maestro">
  <process id="Process_leave_request" isExecutable="true">
    <startEvent id="StartEvent_leave_request" name="Leave requested" />
    <serviceTask id="Task_check_balance" name="Check leave balance" />
    <exclusiveGateway id="Gateway_balance" name="Enough balance?" default="Flow_05" />
    <sendTask id="Task_decline" name="Decline and report remaining balance" />
    <endEvent id="EndEvent_declined" name="Request declined" />
    <userTask id="Task_manager_approval" name="Line manager approval" />
    <exclusiveGateway id="Gateway_duration" name="More than 5 days?" default="Flow_09" />
    <userTask id="Task_head_approval" name="Department head approval" />
    <exclusiveGateway id="Gateway_duration_join" />
    <serviceTask id="Task_deduct" name="Deduct days from balance" />
    <serviceTask id="Task_calendar" name="Add leave to team calendar" />
    <endEvent id="EndEvent_leave_booked" name="Leave booked" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_leave_request" targetRef="Task_check_balance" />
    <sequenceFlow id="Flow_02" sourceRef="Task_check_balance" targetRef="Gateway_balance" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_balance" targetRef="Task_decline" name="insufficient">
      <conditionExpression xsi:type="tFormalExpression">days_requested &gt; balance_remaining</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_decline" targetRef="EndEvent_declined" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_balance" targetRef="Task_manager_approval" name="sufficient" />
    <sequenceFlow id="Flow_06" sourceRef="Task_manager_approval" targetRef="Gateway_duration" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_duration" targetRef="Task_head_approval" name="more than 5">
      <conditionExpression xsi:type="tFormalExpression">days_requested &gt; 5</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_08" sourceRef="Task_head_approval" targetRef="Gateway_duration_join" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_duration" targetRef="Gateway_duration_join" name="5 or fewer" />
    <sequenceFlow id="Flow_10" sourceRef="Gateway_duration_join" targetRef="Task_deduct" />
    <sequenceFlow id="Flow_11" sourceRef="Task_deduct" targetRef="Task_calendar" />
    <sequenceFlow id="Flow_12" sourceRef="Task_calendar" targetRef="EndEvent_leave_booked" />
  </process>
</definitions>
