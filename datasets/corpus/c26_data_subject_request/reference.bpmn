<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs_dsar" targetNamespace="http://uipath.com/maestro">
  <process id="Process_dsar" isExecutable="true">
    <startEvent id="StartEvent_dsar" name="Data subject request received" />
    <serviceTask id="Task_verify_identity" name="Verify requester identity" />
    <parallelGateway id="Gateway_search" name="Search systems in parallel" />
    <serviceTask id="Task_search_crm" name="Search CRM" />
    <serviceTask id="Task_search_support" name="Search support system" />
    <serviceTask id="Task_search_dwh" name="Search data warehouse" />
    <parallelGateway id="Gateway_search_join" />
    <serviceTask id="Task_compile" name="Compile response pack" />
    <userTask id="Task_privacy_review" name="Privacy officer reviews for third party data" />
    <sendTask id="Task_send_pack" name="Send pack to requester" />
    <serviceTask id="Task_record_response" name="Record response for audit" />
    <endEvent id="EndEvent_dsar_done" name="Request answered" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_dsar" targetRef="Task_verify_identity" />
    <sequenceFlow id="Flow_02" sourceRef="Task_verify_identity" targetRef="Gateway_search" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_search" targetRef="Task_search_crm" name="crm" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_search" targetRef="Task_search_support" name="support" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_search" targetRef="Task_search_dwh" name="warehouse" />
    <sequenceFlow id="Flow_06" sourceRef="Task_search_crm" targetRef="Gateway_search_join" />
    <sequenceFlow id="Flow_07" sourceRef="Task_search_support" targetRef="Gateway_search_join" />
    <sequenceFlow id="Flow_08" sourceRef="Task_search_dwh" targetRef="Gateway_search_join" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_search_join" targetRef="Task_compile" />
    <sequenceFlow id="Flow_10" sourceRef="Task_compile" targetRef="Task_privacy_review" />
    <sequenceFlow id="Flow_11" sourceRef="Task_privacy_review" targetRef="Task_send_pack" />
    <sequenceFlow id="Flow_12" sourceRef="Task_send_pack" targetRef="Task_record_response" />
    <sequenceFlow id="Flow_13" sourceRef="Task_record_response" targetRef="EndEvent_dsar_done" />
  </process>
</definitions>
