<?xml version="1.0" encoding="UTF-8"?>
<!-- c08_candidate_screening - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_candidate_screening" targetNamespace="http://uipath.com/maestro">
  <process id="Process_candidate_screening" isExecutable="true">
    <startEvent id="StartEvent_application" name="Application received" />
    <serviceTask id="Task_parse_cv" name="Parse CV" />
    <serviceTask id="Task_score" name="Score CV against requirements" />
    <exclusiveGateway id="Gateway_score" name="Screening score?" default="Flow_11" />
    <sendTask id="Task_auto_reject" name="Send rejection email" />
    <endEvent id="EndEvent_rejected" name="Candidate rejected" />
    <userTask id="Task_recruiter_review" name="Recruiter manual review" />
    <exclusiveGateway id="Gateway_recruiter" name="Shortlist?" default="Flow_08" />
    <sendTask id="Task_recruiter_reject" name="Send rejection email" />
    <endEvent id="EndEvent_rejected_manual" name="Candidate rejected after review" />
    <exclusiveGateway id="Gateway_score_join" />
    <userTask id="Task_book_interview" name="Hiring manager books first interview" />
    <endEvent id="EndEvent_interview_booked" name="Interview booked" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_application" targetRef="Task_parse_cv" />
    <sequenceFlow id="Flow_02" sourceRef="Task_parse_cv" targetRef="Task_score" />
    <sequenceFlow id="Flow_03" sourceRef="Task_score" targetRef="Gateway_score" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_score" targetRef="Task_auto_reject" name="below 40">
      <conditionExpression xsi:type="tFormalExpression">score &lt; 40</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_auto_reject" targetRef="EndEvent_rejected" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_score" targetRef="Task_recruiter_review" name="40 to 69">
      <conditionExpression xsi:type="tFormalExpression">score &lt; 70</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_07" sourceRef="Task_recruiter_review" targetRef="Gateway_recruiter" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_recruiter" targetRef="Task_recruiter_reject" name="reject" />
    <sequenceFlow id="Flow_09" sourceRef="Task_recruiter_reject" targetRef="EndEvent_rejected_manual" />
    <sequenceFlow id="Flow_10" sourceRef="Gateway_recruiter" targetRef="Gateway_score_join" name="shortlist">
      <conditionExpression xsi:type="tFormalExpression">recruiter_decision == 'shortlist'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_11" sourceRef="Gateway_score" targetRef="Gateway_score_join" name="70 or above" />
    <sequenceFlow id="Flow_12" sourceRef="Gateway_score_join" targetRef="Task_book_interview" />
    <sequenceFlow id="Flow_13" sourceRef="Task_book_interview" targetRef="EndEvent_interview_booked" />
  </process>
</definitions>
