<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_access_request" targetNamespace="http://uipath.com/maestro">
  <process id="Process_access_request" isExecutable="true">
    <startEvent id="StartEvent_access_request" name="Access requested" />
    <serviceTask id="Task_lookup_role" name="Look up requested role" />
    <exclusiveGateway id="Gateway_privileged" name="Privileged role?" default="Flow_08" />
    <parallelGateway id="Gateway_dual_approval" name="Dual approval" />
    <userTask id="Task_mgr_approve_priv" name="Line manager approval" />
    <userTask id="Task_owner_approve" name="System owner approval" />
    <parallelGateway id="Gateway_dual_approval_join" />
    <userTask id="Task_mgr_approve_std" name="Line manager approval" />
    <exclusiveGateway id="Gateway_privileged_join" />
    <serviceTask id="Task_grant" name="Grant entitlement" />
    <serviceTask id="Task_log_register" name="Log in access register" />
    <endEvent id="EndEvent_access_granted" name="Access granted" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_access_request" targetRef="Task_lookup_role" />
    <sequenceFlow id="Flow_02" sourceRef="Task_lookup_role" targetRef="Gateway_privileged" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_privileged" targetRef="Gateway_dual_approval" name="privileged">
      <conditionExpression xsi:type="tFormalExpression">role_privileged == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Gateway_dual_approval" targetRef="Task_mgr_approve_priv" name="manager" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_dual_approval" targetRef="Task_owner_approve" name="owner" />
