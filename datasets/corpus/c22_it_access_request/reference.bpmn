    <sequenceFlow id="Flow_07" sourceRef="Task_owner_approve" targetRef="Gateway_dual_approval_join" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_privileged" targetRef="Task_mgr_approve_std" name="standard" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_dual_approval_join" targetRef="Gateway_privileged_join" />
    <sequenceFlow id="Flow_10" sourceRef="Task_mgr_approve_std" targetRef="Gateway_privileged_join" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_privileged_join" targetRef="Task_grant" />
    <sequenceFlow id="Flow_12" sourceRef="Task_grant" targetRef="Task_log_register" />
    <sequenceFlow id="Flow_13" sourceRef="Task_log_register" targetRef="EndEvent_access_granted" />
  </process>
