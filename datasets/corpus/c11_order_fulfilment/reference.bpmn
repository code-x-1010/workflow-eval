<?xml version="1.0" encoding="UTF-8"?>
<!-- c11_order_fulfilment - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_order_fulfilment" targetNamespace="http://uipath.com/maestro">
  <process id="Process_order_fulfilment" isExecutable="true">
    <startEvent id="StartEvent_order" name="Order placed" />
    <serviceTask id="Task_reserve_stock" name="Reserve stock for line item">
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopDataInputRef>line_items</loopDataInputRef>
      </multiInstanceLoopCharacteristics>
    </serviceTask>
    <parallelGateway id="Gateway_prepare" name="Prepare dispatch" />
    <serviceTask id="Task_picking_list" name="Print picking list" />
    <serviceTask id="Task_book_courier" name="Book courier" />
    <parallelGateway id="Gateway_prepare_join" />
    <exclusiveGateway id="Gateway_value" name="Order over 500?" default="Flow_10" />
    <serviceTask id="Task_insure" name="Add shipping insurance" />
    <exclusiveGateway id="Gateway_value_join" />
    <sendTask id="Task_dispatch_confirm" name="Send dispatch confirmation" />
    <endEvent id="EndEvent_dispatched" name="Order dispatched" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_order" targetRef="Task_reserve_stock" />
    <sequenceFlow id="Flow_02" sourceRef="Task_reserve_stock" targetRef="Gateway_prepare" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_prepare" targetRef="Task_picking_list" name="pick" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_prepare" targetRef="Task_book_courier" name="courier" />
    <sequenceFlow id="Flow_05" sourceRef="Task_picking_list" targetRef="Gateway_prepare_join" />
    <sequenceFlow id="Flow_06" sourceRef="Task_book_courier" targetRef="Gateway_prepare_join" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_prepare_join" targetRef="Gateway_value" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_value" targetRef="Task_insure" name="over 500">
      <conditionExpression xsi:type="tFormalExpression">order_value &gt; 500</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_09" sourceRef="Task_insure" targetRef="Gateway_value_join" />
    <sequenceFlow id="Flow_10" sourceRef="Gateway_value" targetRef="Gateway_value_join" name="500 or less" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_value_join" targetRef="Task_dispatch_confirm" />
    <sequenceFlow id="Flow_12" sourceRef="Task_dispatch_confirm" targetRef="EndEvent_dispatched" />
  </process>
</definitions>
