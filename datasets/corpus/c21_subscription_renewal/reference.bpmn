<?xml version="1.0" encoding="UTF-8"?>
<!-- c21_subscription_renewal - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_subscription_renewal" targetNamespace="http://uipath.com/maestro">
  <process id="Process_subscription_renewal" isExecutable="true">
    <startEvent id="StartEvent_pre_expiry" name="30 days before expiry">
      <timerEventDefinition>
        <timeCycle>P30D</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <serviceTask id="Task_usage" name="Check account usage" />
    <serviceTask id="Task_churn_risk" name="Score churn risk" />
    <exclusiveGateway id="Gateway_churn" name="High churn risk?" default="Flow_06" />
    <userTask id="Task_csm_call" name="Customer success manager calls account" />
    <endEvent id="EndEvent_csm_owned" name="Owned by customer success" />
    <sendTask id="Task_renewal_notice" name="Send renewal notice" />
    <serviceTask id="Task_take_payment" name="Take renewal payment" />
    <boundaryEvent id="Boundary_card_declined" attachedToRef="Task_take_payment" name="Card declined">
      <errorEventDefinition />
    </boundaryEvent>
    <serviceTask id="Task_retry_next_day" name="Retry payment next day" />
    <exclusiveGateway id="Gateway_retry" name="Retry succeeded?" default="Flow_11" />
    <endEvent id="EndEvent_renewed_on_retry" name="Renewed on retry" />
    <serviceTask id="Task_collections" name="Hand to collections" />
    <endEvent id="EndEvent_collections" name="Sent to collections" />
    <endEvent id="EndEvent_renewed" name="Subscription renewed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_pre_expiry" targetRef="Task_usage" />
    <sequenceFlow id="Flow_02" sourceRef="Task_usage" targetRef="Task_churn_risk" />
    <sequenceFlow id="Flow_03" sourceRef="Task_churn_risk" targetRef="Gateway_churn" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_churn" targetRef="Task_csm_call" name="high risk">
      <conditionExpression xsi:type="tFormalExpression">churn_risk == 'high'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_csm_call" targetRef="EndEvent_csm_owned" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_churn" targetRef="Task_renewal_notice" name="normal" />
    <sequenceFlow id="Flow_07" sourceRef="Task_renewal_notice" targetRef="Task_take_payment" />
    <sequenceFlow id="Flow_08" sourceRef="Boundary_card_declined" targetRef="Task_retry_next_day" />
    <sequenceFlow id="Flow_09" sourceRef="Task_retry_next_day" targetRef="Gateway_retry" />
    <sequenceFlow id="Flow_10" sourceRef="Gateway_retry" targetRef="EndEvent_renewed_on_retry" name="succeeded">
      <conditionExpression xsi:type="tFormalExpression">payment_captured == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_11" sourceRef="Gateway_retry" targetRef="Task_collections" name="failed" />
    <sequenceFlow id="Flow_12" sourceRef="Task_collections" targetRef="EndEvent_collections" />
    <sequenceFlow id="Flow_13" sourceRef="Task_take_payment" targetRef="EndEvent_renewed" />
  </process>
</definitions>
