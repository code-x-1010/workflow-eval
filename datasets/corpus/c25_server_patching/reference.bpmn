<?xml version="1.0" encoding="UTF-8"?>
<!-- c25_server_patching - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs_server_patching" targetNamespace="http://uipath.com/maestro">
  <process id="Process_server_patching" isExecutable="true">
    <startEvent id="StartEvent_patch_window" name="First Sunday of the month">
      <timerEventDefinition>
        <timeCycle>0 0 1 ? * SUN#1</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <serviceTask id="Task_load_hosts" name="Load servers due for patching" />
    <serviceTask id="Task_snapshot" name="Snapshot host">
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopDataInputRef>hosts</loopDataInputRef>
      </multiInstanceLoopCharacteristics>
    </serviceTask>
    <serviceTask id="Task_patch" name="Patch host">
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopDataInputRef>hosts</loopDataInputRef>
      </multiInstanceLoopCharacteristics>
    </serviceTask>
    <boundaryEvent id="Boundary_patch_failed" attachedToRef="Task_patch" name="Patch failed">
      <errorEventDefinition />
    </boundaryEvent>
    <serviceTask id="Task_rollback" name="Roll back host from snapshot" />
    <serviceTask id="Task_add_exception" name="Add host to exceptions list" />
    <endEvent id="EndEvent_host_excepted" name="Host added to exceptions" />
    <sendTask id="Task_patch_report" name="Send patch report to platform team" />
    <endEvent id="EndEvent_patch_run_done" name="Patch run complete" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_patch_window" targetRef="Task_load_hosts" />
    <sequenceFlow id="Flow_02" sourceRef="Task_load_hosts" targetRef="Task_snapshot" />
    <sequenceFlow id="Flow_03" sourceRef="Task_snapshot" targetRef="Task_patch" />
    <sequenceFlow id="Flow_04" sourceRef="Boundary_patch_failed" targetRef="Task_rollback" />
    <sequenceFlow id="Flow_05" sourceRef="Task_rollback" targetRef="Task_add_exception" />
    <sequenceFlow id="Flow_06" sourceRef="Task_add_exception" targetRef="EndEvent_host_excepted" />
    <sequenceFlow id="Flow_07" sourceRef="Task_patch" targetRef="Task_patch_report" />
    <sequenceFlow id="Flow_08" sourceRef="Task_patch_report" targetRef="EndEvent_patch_run_done" />
  </process>
</definitions>
