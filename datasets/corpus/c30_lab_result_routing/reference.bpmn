<?xml version="1.0" encoding="UTF-8"?>
<!-- c30_lab_result_routing - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_lab_result" targetNamespace="http://uipath.com/maestro">
  <process id="Process_lab_result" isExecutable="true">
    <startEvent id="StartEvent_result" name="Lab result received">
      <messageEventDefinition />
    </startEvent>
    <serviceTask id="Task_match_patient" name="Match result to patient record" />
    <serviceTask id="Task_audit_log" name="Write result to audit log" />
    <exclusiveGateway id="Gateway_critical" name="Critical value?" default="Flow_09" />
    <sendTask id="Task_page_clinician" name="Page on-call clinician" />
    <receiveTask id="Task_await_ack" name="Await clinician acknowledgement" />
    <exclusiveGateway id="Gateway_ack" name="Acknowledged?" default="Flow_08" />
    <endEvent id="EndEvent_escalated" name="Critical result acknowledged">
      <terminateEventDefinition />
    </endEvent>
    <serviceTask id="Task_file_result" name="File result to record" />
    <sendTask id="Task_notify_portal" name="Notify patient through portal" />
    <endEvent id="EndEvent_filed" name="Result filed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_result" targetRef="Task_match_patient" />
    <sequenceFlow id="Flow_02" sourceRef="Task_match_patient" targetRef="Task_audit_log" />
    <sequenceFlow id="Flow_03" sourceRef="Task_audit_log" targetRef="Gateway_critical" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_critical" targetRef="Task_page_clinician" name="critical">
      <conditionExpression xsi:type="tFormalExpression">critical_flag == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_page_clinician" targetRef="Task_await_ack" />
    <sequenceFlow id="Flow_06" sourceRef="Task_await_ack" targetRef="Gateway_ack" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_ack" targetRef="Task_page_clinician" name="page again">
      <conditionExpression xsi:type="tFormalExpression">acknowledged == false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_08" sourceRef="Gateway_ack" targetRef="EndEvent_escalated" name="acknowledged" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_critical" targetRef="Task_file_result" name="normal" />
    <sequenceFlow id="Flow_10" sourceRef="Task_file_result" targetRef="Task_notify_portal" />
    <sequenceFlow id="Flow_11" sourceRef="Task_notify_portal" targetRef="EndEvent_filed" />
  </process>
</definitions>
