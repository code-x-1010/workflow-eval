<!-- u10_automate_onboarding - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. ONE reasonable reading of an under-specified prompt - not ground truth. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs_generic_onboarding" targetNamespace="http://uipath.com/maestro">
  <process id="Process_generic_onboarding" isExecutable="true">
    <startEvent id="StartEvent_new_starter" name="New starter identified" />
    <parallelGateway id="Gateway_setup" name="Set up in parallel" />
    <serviceTask id="Task_accounts" name="Create accounts" />
    <userTask id="Task_paperwork" name="Collect paperwork" />
    <parallelGateway id="Gateway_setup_join" />
    <userTask id="Task_manager_check" name="Manager confirms setup complete" />
    <endEvent id="EndEvent_onboarded" name="Starter onboarded" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_new_starter" targetRef="Gateway_setup" />
    <sequenceFlow id="Flow_02" sourceRef="Gateway_setup" targetRef="Task_accounts" name="accounts" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_setup" targetRef="Task_paperwork" name="paperwork" />
    <sequenceFlow id="Flow_04" sourceRef="Task_accounts" targetRef="Gateway_setup_join" />
    <sequenceFlow id="Flow_05" sourceRef="Task_paperwork" targetRef="Gateway_setup_join" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_setup_join" targetRef="Task_manager_check" />
    <sequenceFlow id="Flow_07" sourceRef="Task_manager_check" targetRef="EndEvent_onboarded" />
  </process>
