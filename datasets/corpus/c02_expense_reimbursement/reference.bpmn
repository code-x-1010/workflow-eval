<?xml version="1.0" encoding="UTF-8"?>
<!-- c02_expense_reimbursement - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_expense_reimbursement" targetNamespace="http://uipath.com/maestro">
  <process id="Process_expense_reimbursement" isExecutable="true">
    <startEvent id="StartEvent_claim" name="Expense claim submitted" />
    <serviceTask id="Task_validate" name="Validate receipts" />
    <exclusiveGateway id="Gateway_valid" name="Receipts valid?" default="Flow_05" />
    <sendTask id="Task_reject" name="Notify employee of rejection" />
    <endEvent id="EndEvent_rejected" name="Claim rejected" />
    <exclusiveGateway id="Gateway_tier" name="Claim amount tier?" default="Flow_07" />
    <userTask id="Task_manager" name="Line manager approval" />
    <userTask id="Task_director" name="Finance director approval" />
    <exclusiveGateway id="Gateway_tier_join" />
    <serviceTask id="Task_pay" name="Raise reimbursement payment" />
    <sendTask id="Task_confirm" name="Email confirmation to employee" />
    <endEvent id="EndEvent_reimbursed" name="Employee reimbursed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_claim" targetRef="Task_validate" />
    <sequenceFlow id="Flow_02" sourceRef="Task_validate" targetRef="Gateway_valid" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_valid" targetRef="Task_reject" name="invalid">
      <conditionExpression xsi:type="tFormalExpression">receipts_valid == false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_reject" targetRef="EndEvent_rejected" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_valid" targetRef="Gateway_tier" name="valid" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_tier" targetRef="Task_manager" name="100 to 1000">
      <conditionExpression xsi:type="tFormalExpression">amount &gt;= 100 and amount &lt;= 1000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_07" sourceRef="Gateway_tier" targetRef="Task_director" name="over 1000" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_tier" targetRef="Gateway_tier_join" name="under 100">
      <conditionExpression xsi:type="tFormalExpression">amount &lt; 100</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_09" sourceRef="Task_manager" targetRef="Gateway_tier_join" />
    <sequenceFlow id="Flow_10" sourceRef="Task_director" targetRef="Gateway_tier_join" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_tier_join" targetRef="Task_pay" />
    <sequenceFlow id="Flow_12" sourceRef="Task_pay" targetRef="Task_confirm" />
    <sequenceFlow id="Flow_13" sourceRef="Task_confirm" targetRef="EndEvent_reimbursed" />
  </process>
</definitions>
