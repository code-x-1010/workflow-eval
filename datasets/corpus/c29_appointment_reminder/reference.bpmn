<?xml version="1.0" encoding="UTF-8"?>
<!-- c29_appointment_reminder - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_appointment_reminder" targetNamespace="http://uipath.com/maestro">
  <process id="Process_appointment_reminder" isExecutable="true">
    <startEvent id="StartEvent_two_days_before" name="Two days before appointment">
      <timerEventDefinition>
        <timeCycle>P2D</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <sendTask id="Task_send_reminder" name="Text appointment reminder" />
    <receiveTask id="Task_await_reply" name="Await patient reply" />
    <exclusiveGateway id="Gateway_reply" name="Patient reply?" default="Flow_09" />
    <serviceTask id="Task_mark_confirmed" name="Mark appointment confirmed" />
    <endEvent id="EndEvent_confirmed" name="Appointment confirmed" />
    <serviceTask id="Task_release_slot" name="Release slot" />
    <sendTask id="Task_offer_waitlist" name="Offer slot to waiting list" />
    <endEvent id="EndEvent_cancelled" name="Appointment cancelled" />
    <userTask id="Task_receptionist_call" name="Receptionist rings patient" />
    <endEvent id="EndEvent_reminder_done" name="Reminder handled" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_two_days_before" targetRef="Task_send_reminder" />
    <sequenceFlow id="Flow_02" sourceRef="Task_send_reminder" targetRef="Task_await_reply" />
    <sequenceFlow id="Flow_03" sourceRef="Task_await_reply" targetRef="Gateway_reply" />
    <sequenceFlow id="Flow_04" sourceRef="Gateway_reply" targetRef="Task_mark_confirmed" name="confirmed">
      <conditionExpression xsi:type="tFormalExpression">reply == 'confirm'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_05" sourceRef="Task_mark_confirmed" targetRef="EndEvent_confirmed" />
    <sequenceFlow id="Flow_06" sourceRef="Gateway_reply" targetRef="Task_release_slot" name="cancelled">
      <conditionExpression xsi:type="tFormalExpression">reply == 'cancel'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_07" sourceRef="Task_release_slot" targetRef="Task_offer_waitlist" />
    <sequenceFlow id="Flow_08" sourceRef="Task_offer_waitlist" targetRef="EndEvent_cancelled" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_reply" targetRef="Task_receptionist_call" name="no reply" />
    <sequenceFlow id="Flow_10" sourceRef="Task_receptionist_call" targetRef="EndEvent_reminder_done" />
  </process>
</definitions>
