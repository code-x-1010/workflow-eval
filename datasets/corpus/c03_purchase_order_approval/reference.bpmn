<?xml version="1.0" encoding="UTF-8"?>
<!-- c03_purchase_order_approval - reference artifact for the prompt in prompt.txt. Generated by datasets/build_corpus.py; edit datasets/tools/cases_*.py, not this file. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_purchase_order" targetNamespace="http://uipath.com/maestro">
  <process id="Process_purchase_order" isExecutable="true">
    <startEvent id="StartEvent_po" name="Purchase order raised" />
    <serviceTask id="Task_risk_lookup" name="Look up vendor risk rating" />
    <exclusiveGateway id="Gateway_value" name="Order value 50000 or more?" default="Flow_08" />
    <userTask id="Task_procurement_review" name="Procurement review" />
    <exclusiveGateway id="Gateway_risk" name="Vendor high risk?" default="Flow_07" />
    <userTask id="Task_compliance" name="Compliance sign-off" />
    <exclusiveGateway id="Gateway_risk_join" />
    <serviceTask id="Task_autoapprove" name="Auto-approve order" />
    <exclusiveGateway id="Gateway_value_join" />
    <sendTask id="Task_send_po" name="Send order to vendor" />
    <serviceTask id="Task_ledger" name="Record order in ledger" />
    <endEvent id="EndEvent_po_placed" name="Order placed" />
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_po" targetRef="Task_risk_lookup" />
    <sequenceFlow id="Flow_02" sourceRef="Task_risk_lookup" targetRef="Gateway_value" />
    <sequenceFlow id="Flow_03" sourceRef="Gateway_value" targetRef="Task_procurement_review" name="50000 or more">
      <conditionExpression xsi:type="tFormalExpression">order_value &gt;= 50000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_04" sourceRef="Task_procurement_review" targetRef="Gateway_risk" />
    <sequenceFlow id="Flow_05" sourceRef="Gateway_risk" targetRef="Task_compliance" name="high risk">
      <conditionExpression xsi:type="tFormalExpression">vendor_risk == 'high'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_06" sourceRef="Task_compliance" targetRef="Gateway_risk_join" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_risk" targetRef="Gateway_risk_join" name="not high risk" />
    <sequenceFlow id="Flow_08" sourceRef="Gateway_value" targetRef="Task_autoapprove" name="under 50000" />
    <sequenceFlow id="Flow_09" sourceRef="Gateway_risk_join" targetRef="Gateway_value_join" />
    <sequenceFlow id="Flow_10" sourceRef="Task_autoapprove" targetRef="Gateway_value_join" />
    <sequenceFlow id="Flow_11" sourceRef="Gateway_value_join" targetRef="Task_send_po" />
    <sequenceFlow id="Flow_12" sourceRef="Task_send_po" targetRef="Task_ledger" />
    <sequenceFlow id="Flow_13" sourceRef="Task_ledger" targetRef="EndEvent_po_placed" />
  </process>
</definitions>
