<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared fixture. Every agent's golden example should reference THESE ids so
     the examples compose into a coherent end-to-end story. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs_invoice" targetNamespace="http://uipath.com/maestro">
  <process id="Process_invoice_approval" isExecutable="true">
    <startEvent id="StartEvent_invoice" name="Invoice received"/>
    <serviceTask id="Task_extract" name="Extract invoice fields"/>
    <exclusiveGateway id="Gateway_amount" name="Amount over 10000?"/>
    <userTask id="Task_approval" name="Manager approval"/>
    <serviceTask id="Task_autopay" name="Auto-pay invoice"/>
    <serviceTask id="Task_notify" name="Notify vendor"/>
    <endEvent id="EndEvent_done" name="Invoice settled"/>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_invoice" targetRef="Task_extract"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_extract" targetRef="Gateway_amount"/>
    <sequenceFlow id="Flow_3" sourceRef="Gateway_amount" targetRef="Task_approval" name="over"/>
    <sequenceFlow id="Flow_4" sourceRef="Gateway_amount" targetRef="Task_autopay" name="under"/>
    <sequenceFlow id="Flow_5" sourceRef="Task_approval" targetRef="Task_notify"/>
    <sequenceFlow id="Flow_6" sourceRef="Task_autopay" targetRef="Task_notify"/>
    <sequenceFlow id="Flow_7" sourceRef="Task_notify" targetRef="EndEvent_done"/>
  </process>
</definitions>
